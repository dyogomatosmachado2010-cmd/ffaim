# LF em tudo que roda no runner Linux/macOS. CRLF em .sh quebra com
# "bad interpreter: /bin/sh^M" no GitHub Actions.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.mm      text eol=lf
*.h       text eol=lf
*.cfg     text eol=lf
*.plist   text eol=lf
Makefile  text eol=lf

*.ipa     binary
*.deb     binary
*.dylib   binary
*.png     binary
